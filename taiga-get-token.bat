@echo off
setlocal
title Taiga Token Setup

echo.
echo ========================================
echo        Taiga API - Token Setup
echo ========================================
echo.
echo Existing TAIGA_BASE_URL will be preserved.
echo On successful login, .env will be replaced with three
echo separate lines: base URL, access token, refresh token.
echo.

where powershell.exe >nul 2>&1
if errorlevel 1 (
    echo ERROR: Windows PowerShell was not found.
    pause
    exit /b 1
)

powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set "RESULT=%ERRORLEVEL%"

echo.
if not "%RESULT%"=="0" (
    echo Token setup failed. The existing .env file was not modified
    echo unless the write itself succeeded before verification failed.
) else (
    echo New Taiga tokens are saved in .env.
)
echo.
pause
exit /b %RESULT%
